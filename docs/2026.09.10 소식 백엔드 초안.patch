+package app.application.news;
+
+import app.core.data.response.constant.StatusCode;
+import app.core.exception.BusinessException;
+import app.domain.news.*;
+import java.time.Clock;
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+@Service
+@RequiredArgsConstructor
+@Transactional(readOnly = true)
+public class NewsService {
+  private static final int PAGE_SIZE = 20;
+  private final NewsPostRepository repository;
+  private final Clock loginAuthClock;
+
+  public NewsPage list(NewsCategory category, int page) {
+    if (page < 0 || page > 10000) throw new BusinessException(StatusCode.BAD_REQUEST);
+    List<NewsPost> posts = repository.findPage(category, page * PAGE_SIZE, PAGE_SIZE + 1);
+    return new NewsPage(
+        posts.stream().limit(PAGE_SIZE).map(NewsSummary::from).toList(),
+        page,
+        posts.size() > PAGE_SIZE);
+  }
+
+  public NewsDetail get(UUID id) {
+    return NewsDetail.from(require(id));
+  }
+
+  @Transactional
+  public NewsDetail publish(UUID authorId, NewsCategory category, String title, String content) {
+    return NewsDetail.from(
+        repository.save(
+            NewsPost.publish(authorId, category, title, content, loginAuthClock.instant())));
+  }
+
+  @Transactional
+  public NewsDetail edit(UUID id, NewsCategory category, String title, String content) {
+    NewsPost post = require(id);
+    post.edit(category, title, content, loginAuthClock.instant());
+    return NewsDetail.from(repository.save(post));
+  }
+
+  @Transactional
+  public void delete(UUID id) {
+    repository.delete(require(id));
+  }
+
+  private NewsPost require(UUID id) {
+    return repository
+        .findById(id)
+        .orElseThrow(() -> new BusinessException(StatusCode.NEWS_NOT_FOUND));
+  }
+
+  public record NewsPage(List<NewsSummary> items, int page, boolean hasNext) {}
+
+  public record NewsSummary(
+      UUID id, NewsCategory category, String title, Instant createdAt, Instant updatedAt) {
+    static NewsSummary from(NewsPost p) {
+      return new NewsSummary(
+          p.getId(), p.getCategory(), p.getTitle(), p.getCreatedAt(), p.getUpdatedAt());
+    }
+  }
+
+  public record NewsDetail(
+      UUID id,
+      NewsCategory category,
+      String title,
+      String content,
+      Instant createdAt,
+      Instant updatedAt) {
+    static NewsDetail from(NewsPost p) {
+      return new NewsDetail(
+          p.getId(),
+          p.getCategory(),
+          p.getTitle(),
+          p.getContent(),
+          p.getCreatedAt(),
+          p.getUpdatedAt());
+    }
+  }
+}

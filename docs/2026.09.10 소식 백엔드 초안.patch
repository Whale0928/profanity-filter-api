+package app.domain.news;
+
+import jakarta.persistence.*;
+import java.time.Instant;
+import java.util.UUID;
+import lombok.AccessLevel;
+import lombok.Getter;
+import lombok.NoArgsConstructor;
+
+@Getter
+@Entity
+@Table(name = "news_posts")
+@NoArgsConstructor(access = AccessLevel.PROTECTED)
+public class NewsPost {
+  @Id
+  @Column(columnDefinition = "BINARY(16)")
+  private UUID id;
+
+  @Enumerated(EnumType.STRING)
+  @Column(nullable = false, length = 20)
+  private NewsCategory category;
+
+  @Column(nullable = false, length = 160)
+  private String title;
+
+  @Column(nullable = false, columnDefinition = "mediumtext")
+  private String content;
+
+  @Column(name = "author_id", nullable = false, columnDefinition = "BINARY(16)")
+  private UUID authorId;
+
+  @Column(name = "created_at", nullable = false, updatable = false)
+  private Instant createdAt;
+
+  @Column(name = "updated_at", nullable = false)
+  private Instant updatedAt;
+
+  public static NewsPost publish(
+      UUID authorId, NewsCategory category, String title, String content, Instant now) {
+    NewsPost post = new NewsPost();
+    post.id = UUID.randomUUID();
+    post.authorId = java.util.Objects.requireNonNull(authorId);
+    post.createdAt = now;
+    post.edit(category, title, content, now);
+    return post;
+  }
+
+  public void edit(NewsCategory category, String title, String content, Instant now) {
+    if (category == null
+        || title == null
+        || title.isBlank()
+        || title.length() > 160
+        || content == null
+        || content.isBlank()
+        || content.length() > 50000) {
+      throw new IllegalArgumentException("Invalid news post");
+    }
+    this.category = category;
+    this.title = title.strip();
+    this.content = content;
+    this.updatedAt = java.util.Objects.requireNonNull(now);
+  }
+}
